# Copia questo file in ".env" e modifica i valori. NON inserire mai la chiave nel codice e NON pubblicare il file ".env".
# Le chiavi restano solo sul server: il browser non le vede mai.

# ── Rete ──────────────────────────────────────────────────────────────
PORT=3300
# 127.0.0.1 = solo questo computer. 0.0.0.0 = raggiungibile dagli altri dispositivi della rete scolastica (leggi docs/RETE_LOCALE.md).
HOST=127.0.0.1
# Omar AI è un'APPLICAZIONE: l'interfaccia si apre solo dall'icona «Omar AI» (non da un normale browser).
# Solo per un server della scuola in rete locale: DESKTOP_ONLY=false insieme a HOST=0.0.0.0 (docs/RETE_LOCALE.md).
DESKTOP_ONLY=true

# ── Provider IA ───────────────────────────────────────────────────────
# openai-compatible = modello LOCALE (Ollama, LM Studio, llama.cpp: i testi NON lasciano la scuola) oppure OpenAI, Mistral, vLLM…
# anthropic         = API di Anthropic (i testi lasciano la rete scolastica)
# demo              = SOLO PER I TEST AUTOMATICI: nessun modello IA, risposte simulate e sempre segnalate come tali.
# "npm run setup:ollama" (lanciato da avvia-omar.bat) compila da solo queste righe dopo aver provato davvero il modello.
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen2.5:7b
# AI_API_KEY=inserisci-qui-la-chiave   (non serve per Ollama)
AI_TIMEOUT_MS=120000
# AI_MAX_TOKENS=1200
# AI_TEMPERATURE=0.4
# AI_DAILY_LIMIT_PER_USER=150
# Modello «vista»: legge foto, schermate, schizzi a mano e PDF scansionati (descrizione + trascrizione del testo).
# Se vuoto, Omar cerca da solo tra i modelli Ollama installati (qwen2.5vl, gemma3, llama3.2-vision, minicpm-v, llava…).
AI_VISION=true
# AI_VISION_MODEL=qwen2.5vl:3b
# AI_VISION_TIMEOUT_MS=240000

# ── Registrazione (codici consegnati dal docente) ─────────────────────
STUDENT_REGISTRATION_CODE=ER26OCT08
TEACHER_REGISTRATION_CODE=cambia-questo-codice-docenti
# Solo per prove: registrazione senza codice (mai come docente)
ALLOW_OPEN_REGISTRATION=false
MIN_PASSWORD_LENGTH=10

# ── Dati e conservazione (giorni) ─────────────────────────────────────
DATA_DIR=./data
RETENTION_CHAT_DAYS=180
RETENTION_AUTH_DAYS=30
RETENTION_AUDIT_DAYS=90
RETENTION_EVENTS_DAYS=60

# ── Collaborazione ────────────────────────────────────────────────────
INVITE_TTL_MIN=30
INVITE_MAX_USES=10
MAX_UPLOAD_MB=25
MAX_PROJECT_MB=200
# Funzioni IA aggiuntive del gruppo (diario e Scatola Nera): metti false per usare solo le regole deterministiche
JOURNAL_AI=true
BLACKBOX_AI=true

# ── Email scolastica degli studenti ───────────────────────────────────
# Gli studenti si registrano solo con un indirizzo di questo dominio (il docente non è vincolato). Vuoto = nessun vincolo (solo prove).
# NB: l'app NON verifica che la casella esista: il controllo del dominio non è una prova d'identità. Il codice di registrazione resta il secondo filtro.
STUDENT_EMAIL_DOMAIN=itiomar.net

# ── Accesso al web: «Importa un link» e «Cerca» ───────────────────────
# Le richieste partono SOLO dal server. «Cerca» è spento di default nell'interfaccia: lo studente lo attiva quando vuole.
LINKS_ENABLED=true
# duckduckgo (nessuna chiave; NON è un'API ufficiale e può smettere di funzionare) | brave | searxng | off
WEB_SEARCH_PROVIDER=duckduckgo
# BRAVE_API_KEY=
# SEARXNG_URL=http://searxng.scuola.local:8080
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_FETCH_PAGES=2
# WEB_SEARCH_PER_MIN=10
# LINKS_PER_MIN=12
# WEB_TIMEOUT_MS=8000
# WEB_MAX_PAGE_KB=2048
# ATTENZIONE: spegne la protezione contro l'accesso a reti interne. Solo per prove automatiche, mai su un server vero.
# ALLOW_PRIVATE_LINKS=false

# ── Quick Tools: esecuzione di Python e C++ sul server ───────────────
# JavaScript si esegue sempre nel browser (isolato, senza rete). Python e C++ invece girerebbero SUL SERVER:
# accendilo solo su un computer dedicato e solo se sai cosa comporta (limiti di tempo e di output, nessun vero isolamento).
CODE_RUNNER_ENABLED=false
# CODE_RUNNER_PYTHON=python
# CODE_RUNNER_CXX=g++
# CODE_RUNNER_TIMEOUT_MS=5000
